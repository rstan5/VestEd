# VestEd environment template
# The local prototype runs without any of these values.
# Do not commit real secrets. Do not prefix service credentials with NEXT_PUBLIC_.

# Supabase — local stack from supabase/config.toml (API on http://127.0.0.1:3130).
# Fill these in .env.local from `npx supabase status -o env`, never here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Market data — adapter not connected in this milestone
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# AI Professor — demonstration mode is used when these are empty
AI_PROVIDER=
AI_API_KEY=
